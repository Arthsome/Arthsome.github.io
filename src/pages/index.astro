---
import '../styles/g.css';
const svg=(p,f)=>`<svg viewBox="0 0 24 24" width="20" height="20" fill="${f?'currentColor':'none'}" stroke="${f?'none':'currentColor'}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const I={
  mail:svg('<rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'),
  x:svg('<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',1),
  ig:svg('<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>'),
  gh:svg('<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>',1),
  up:svg('<path d="M7 17 17 7M8 7h9v9"/>'),
  down:svg('<path d="M12 4v16M6 14l6 6 6-6"/>'),
  copy:svg('<rect x="9" y="9" width="13" height="13" rx="2.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>'),
  work:svg('<rect x="3" y="7" width="18" height="14" rx="2.5"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 12h18"/>'),
  services:svg('<path d="M4 6h16M4 12h16M4 18h10"/>'),
  projects:svg('<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"/>'),
  contact:svg('<path d="M4 5h16v14H4zM4 7l8 6 8-6"/>')
};
/* Vance monogram — a faceted V cut from one ribbon, with a signal dot */
const MARK=`<svg class="vmark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path class="mk-body" d="M8 12 L28 54 H37 L57 12 H47 L32 43 L18 12 Z" fill="url(#vance-g)"/><path class="mk-cut" d="M28 54 H37 L34.5 46 H30.5 Z" fill="#121712"/><circle class="mk-dot" cx="50" cy="16" r="3.2" fill="#D6FB54"/></svg>`;
const EMAIL='vancxe@aster.cx',X='https://x.com/vancxef',IG='https://instagram.com/thepersonarya';
const disc=['Penetration testing','Bug bounty','Vulnerability analysis','Reverse engineering','Detection engineering','Incident response'];
const work=[
  {m:'CVE-2025-20281',s:'CVSS 10.0',t:'Unauthenticated RCE in Cisco ISE',d:'Root-cause analysis of a critical pre-auth remote code execution: the broken invariant, the code path, why the patch holds, and detections defenders can deploy on day one.',o:'Root cause, patch analysis, and detections defenders can deploy on day one.',h:'/posts/cve-2025-20281/index.html',big:'10.0',g:'#C6F440'},
  {m:'MITRE T1027',s:'Technique',t:'Walsh–Hadamard payload obfuscation',d:'How a Walsh–Hadamard transform hides shellcode from static analysis, with spectral analysis, key sensitivity and a working pipeline.',o:'Spectral analysis, key sensitivity, and a working obfuscation pipeline.',h:'/posts/wht-shellcode-obfuscation/index.html',big:'WHT',g:'#B6F13B'},
  {m:'HackerOne',s:'Bugcrowd',t:'Bug bounty hunting',d:'Web, mobile, AI and Web3 targets. Findings stay private until the vendor ships the fix.',o:'Findings stay private until the vendor ships the fix.',h:null,big:'H1',g:'#97EA1E'}
];
const approach=[
  ['01','Scope','Testing starts with a clear scope. You know what is in bounds before work begins.'],
  ['02','Test','Web apps, APIs and mobile apps, tested manually. No scanner output passed off as findings.'],
  ['03','Reproduce','Every finding comes with steps your team can run and verify.'],
  ['04','Publish','Write-ups and detections ship after the patch is live.']
];
const svc=[
  ['Penetration testing','Scoped, manual testing of web apps, APIs and mobile apps. You get reproducible findings with a fix path, not scanner output.'],
  ['Bug bounty','Independent hunting on HackerOne and Bugcrowd, reported with clear impact and working proof.'],
  ['Vulnerability analysis','Root-cause write-ups for disclosed CVEs: what broke, where in the code, and why the patch works.'],
  ['Reverse engineering','Disassembly and behavioural analysis of binaries, obfuscation and malware techniques.'],
  ['Detection engineering','Sigma, Suricata and SIEM queries shipped alongside every report.'],
  ['Incident response','Forensic notes that help responders validate scope and hunt the pattern.']
];
const proj=[['oh-my-pi','Coding agent with the IDE wired in','https://github.com/Vance/oh-my-pi'],['chime-health-check','Python health-check tooling','https://github.com/Vance/chime-health-check']];
const stats=[[2,'Public analyses'],[1,'CVE with detection rules'],[10,'Top CVSS score'],[6,'Disciplines']];
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Vance | Security researcher</title>
<meta name="description" content="Vance is an independent security researcher: penetration testing, bug bounty, vulnerability analysis and reverse engineering. Business inquiries: vancxe@aster.cx">
<meta name="theme-color" content="#F4F5EE"><meta property="og:title" content="Vance | Security researcher"><meta property="og:description" content="Finding what breaks before it does. Penetration testing, bug bounty and vulnerability research."><meta property="og:type" content="website"><meta name="twitter:card" content="summary">
<link rel="icon" type="image/svg+xml" href="/assets/img/vance-mark.svg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gloock&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Onest:wght@300..800&display=swap"></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<svg class="svg-defs" aria-hidden="true" focusable="false"><linearGradient id="vance-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#D6FB54"/><stop offset=".52" stop-color="#8FE98A"/><stop offset="1" stop-color="#59CFD6"/></linearGradient><filter id="liquid-refract" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency="0.01 0.014" numOctaves="2" seed="7" result="noise"/><feGaussianBlur in="noise" stdDeviation="1.6" result="soft"/><feDisplacementMap in="SourceGraphic" in2="soft" scale="12" xChannelSelector="R" yChannelSelector="G"/></filter></svg>

<div class="ambient" aria-hidden="true"></div>
<div class="cur-dot" aria-hidden="true"></div><div class="cur-ring" aria-hidden="true"></div>
<div class="prog" aria-hidden="true"></div>
<header class="nav"><div class="bar glass">
  <a class="logo" href="#top" aria-label="Vance, back to top"><span class="logo-mark" set:html={MARK}></span>Vance</a>
  <nav class="links" aria-label="Main"><span class="nav-pill" aria-hidden="true"></span><a href="#work"><small>01</small>Work</a><a href="#services"><small>02</small>Services</a><a href="#projects"><small>03</small>Projects</a></nav>
  <a class="btn sm ink" data-mag href={`mailto:${EMAIL}`}>Hire me<Fragment set:html={I.up}/></a>
</div></header>

<nav class="tabbar glass" aria-label="Mobile">
  <span class="tab-drop" aria-hidden="true"></span>
  <a href="#work" data-tab="work"><Fragment set:html={I.work}/><span>Work</span></a>
  <a href="#services" data-tab="services"><Fragment set:html={I.services}/><span>Services</span></a>
  <a href="#projects" data-tab="projects"><Fragment set:html={I.projects}/><span>Projects</span></a>
  <a href="#contact" data-tab="contact"><Fragment set:html={I.contact}/><span>Contact</span></a>
</nav>

<main id="main">
<section class="hero" id="top">
  <div class="hero-watermark" aria-hidden="true" set:html={MARK}></div>
  <div class="scanline" aria-hidden="true"></div>
  <div class="hero-rail" aria-hidden="true"><span>VANCE — INDEPENDENT SECURITY RESEARCH — EST. 2026</span><i></i></div>
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="eyebrow rv"><span class="pulse"></span>Independent security research · 2026</p>
      <h1 id="h1"><span class="line">Finding what</span><span class="line"><span class="mark">breaks</span> before</span><span class="line">it does.</span></h1>
      <p class="lede rv"><strong>I'm Vance, an independent security researcher.</strong> Penetration testing, bug bounty and vulnerability research, with write-ups and detections published after the patch.</p>
      <div class="cta-row rv"><a class="btn" data-mag href={`mailto:${EMAIL}`}>Start a conversation<Fragment set:html={I.up}/></a><a class="btn ghost" data-mag href="#work">See the research<Fragment set:html={I.down}/></a></div>
      <div class="indexline rv"><span>00 / Introduction</span><span>Scroll to explore</span></div>
    </div>
    <aside class="plate glass glass--shimmer" data-spot aria-label="Profile summary">
      <span class="plate-no">V—01</span>
      <figure class="plate-fig"><img src="/assets/img/portrait/crystal.png" alt="Vance crystal mark: a faceted form intersected by acid-lime traces"><figcaption>Fig. 01 — Structure under load</figcaption></figure>
      <div class="plate-meta">
        <div><span class="k">Focus</span><span class="v">Offensive security</span></div>
        <div><span class="k">Method</span><span class="v">Manual &amp; reproducible</span></div>
        <div><span class="k">Status</span><span class="v"><i></i>Open for inquiries</span></div>
      </div>
    </aside>
  </div>
  <div class="dock wrap"><div class="dock-inner glass">
    <div class="dk dk-main" data-spot><span class="ic" set:html={I.mail}></span><span class="dk-t"><span class="dk-l">Business inquiries</span><span class="dk-v">{EMAIL}</span></span><button class="copy" data-copy={EMAIL} aria-label="Copy email address" set:html={I.copy}></button></div>
    <a class="dk" data-spot href={X} target="_blank" rel="noopener"><span class="ic" set:html={I.x}></span><span class="dk-t"><span class="dk-l">X</span><span class="dk-v">@vancxef</span></span></a>
    <a class="dk" data-spot href={IG} target="_blank" rel="noopener"><span class="ic" set:html={I.ig}></span><span class="dk-t"><span class="dk-l">Instagram</span><span class="dk-v">@thepersonarya</span></span></a>
  </div></div>
</section>

<div class="ticker" aria-hidden="true"><div class="ticker-t">{[0,1].map(()=><div class="ticker-g">{disc.map(d=><><span>{d}</span><b></b></>)}</div>)}</div></div>

<section class="position"><div class="wrap position-inner">
  <p class="tag">01 / Position</p>
  <p class="statement" id="stmt">I take systems apart to find the flaw that breaks them, then write it up so the people who defend them can find it too.</p>
</div></section>

<section id="work"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">02 / Selected work</p><h2 class="rh">Research, published after the patch.</h2></div><p class="sub">Root-cause analysis, working proof and detections — released once the fix is live.</p></div>
  <div class="stack">{work.map((w,i)=>
   <article class="wc glass" style={`--g:${w.g}`} data-spot>
    <div class="wc-top"><span class="chip">{String(i+1).padStart(2,'0')} / {w.m}</span><span class={'chip'+(i===0?' hot':'')}>{w.s}</span></div>
    <h3>{w.t}</h3>
    <div class="wc-out"><span>OUTCOME</span><p>{w.o}</p></div>
    <div class="wc-bot"><p>{w.d}</p>{w.h?<a class="btn" data-mag href={w.h}>Read the analysis<Fragment set:html={I.up}/></a>:<span class="chip">Private until fixed</span>}</div>
    <span class="wc-stamp" aria-hidden="true">FILE / 0{i+1}<b></b>VERIFIED</span>
    <span class="big" aria-hidden="true">{w.big}</span>
   </article>)}</div>
</div></section>

<section id="services"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">03 / Services</p><h2 class="rh">Where I can help.</h2></div><p class="sub">Hands-on work, scoped clearly, reported so your team can reproduce and fix it.</p></div>
  <div class="ledger">{svc.map((s,i)=><div class="sv" data-spot><span class="sv-n"><i class="sv-node"></i>{String(i+1).padStart(2,'0')}</span><h3>{s[0]}</h3><p>{s[1]}</p><span class="sv-arrow" set:html={I.up}></span></div>)}</div>
</div></section>

<section id="approach"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">04 / Approach</p><h2 class="rh">How the work runs.</h2></div><p class="sub">The same sequence on every engagement, from the first scope call to the published write-up.</p></div>
  <div class="steps">{approach.map(a=><div class="step"><span class="step-n">{a[0]}</span><h3>{a[1]}</h3><p>{a[2]}</p></div>)}</div>
  <div class="credentials"><span>CVE-2025-20281</span><b></b><span>MITRE ATT&amp;CK T1027</span><b></b><span>HackerOne</span><b></b><span>Bugcrowd</span><b></b><span>Cisco ISE</span></div>
</div></section>

<div class="wrap"><div class="stats">{stats.map(s=><div class="stat"><b data-n={s[0]}>0</b><span>{s[1]}</span></div>)}</div></div>

<section id="projects"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">05 / Projects</p><h2 class="rh">Side experiments.</h2></div></div>
  <div>{proj.map((p,i)=><a class="pj" href={p[2]} target="_blank" rel="noopener"><span class="pj-n">{String(i+1).padStart(2,'0')}</span><strong>{p[0]}</strong><span class="d">{p[1]}</span><span class="arr" set:html={I.up}></span></a>)}</div>
</div></section>

<section id="contact"><div class="wrap">
  <div class="contact-panel glass glass--shimmer" data-spot>
    <span class="contact-mark" aria-hidden="true" set:html={MARK}></span>
    <div class="contact-grid">
      <div><p class="sec-label">06 / Contact</p><h2 class="rh">Have something worth testing?</h2><a class="mail" data-mag href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <div class="soc"><a class="btn" data-mag href={`mailto:${EMAIL}`}>Business inquiries<Fragment set:html={I.up}/></a><a class="btn ghost" data-mag href={X} target="_blank" rel="noopener"><Fragment set:html={I.x}/>@vancxef</a><a class="btn ghost" data-mag href={IG} target="_blank" rel="noopener"><Fragment set:html={I.ig}/>@thepersonarya</a><a class="btn ghost" data-mag href="https://github.com/Vance" target="_blank" rel="noopener"><Fragment set:html={I.gh}/>GitHub</a></div>
      </div>
      <p class="contact-note">Work is scoped clearly and reported so your team can reproduce and fix it. Findings stay private until the vendor ships the fix.</p>
    </div>
  </div>
</div></section>
</main>

<footer><div class="wrap"><div class="fl"><span>© 2026 Vance</span><span>Independent security research</span><a href="#top">Back to top ↑</a></div><div class="wm" aria-hidden="true"><span class="wm-mark" set:html={MARK}></span><span>Vance</span></div></div></footer>

<script>
import {gsap} from 'gsap';import {ScrollTrigger} from 'gsap/ScrollTrigger';import Lenis from 'lenis';
gsap.registerPlugin(ScrollTrigger);
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,fine=matchMedia('(pointer:fine)').matches;

/* copy email */
$$('.copy').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.dataset.copy)}catch(_){const t=document.createElement('textarea');t.value=b.dataset.copy;document.body.append(t);t.select();document.execCommand('copy');t.remove()}b.setAttribute('data-ok','');setTimeout(()=>b.removeAttribute('data-ok'),1600)}));

/* glass specular follows the pointer */
document.addEventListener('pointermove',e=>{const t=e.target.closest&&e.target.closest('[data-spot]');if(t){const r=t.getBoundingClientRect();t.style.setProperty('--x',e.clientX-r.left+'px');t.style.setProperty('--y',e.clientY-r.top+'px')}},{passive:true});

/* ambient light + cursor lens: one pointer stream, three independent followers */
const ambient=$('.ambient');
if(!reduce&&fine){
 const dot=$('.cur-dot'),ring=$('.cur-ring');
 const dx=gsap.quickTo(dot,'x',{duration:.12,ease:'power3'}),dy=gsap.quickTo(dot,'y',{duration:.12,ease:'power3'});
 const rx=gsap.quickTo(ring,'x',{duration:.5,ease:'power3'}),ry=gsap.quickTo(ring,'y',{duration:.5,ease:'power3'});
 const ax=gsap.quickTo(ambient,'x',{duration:1.4,ease:'power3'}),ay=gsap.quickTo(ambient,'y',{duration:1.4,ease:'power3'});
 let seen=false;
 addEventListener('pointermove',e=>{
  dx(e.clientX);dy(e.clientY);rx(e.clientX);ry(e.clientY);ax(e.clientX);ay(e.clientY);
  if(!seen){seen=true;dot.classList.add('on');ring.classList.add('on')}
 },{passive:true});
 document.addEventListener('pointerover',e=>{ring.classList.toggle('is-wide',!!(e.target.closest&&e.target.closest('a,button,.wc,.sv')))});
 document.addEventListener('pointerleave',()=>{dot.classList.remove('on');ring.classList.remove('on')});
}else if(ambient){ambient.style.opacity='.4'}

/* nav: a glass pill that travels to the hovered/focused link */
const links=$('.links'),pill=$('.nav-pill');
if(links&&pill){
 const px=gsap.quickTo(pill,'x',{duration:.5,ease:'power3'}),pw=gsap.quickTo(pill,'width',{duration:.5,ease:'power3'});
 const travel=el=>{if(!el)return;const a=el.getBoundingClientRect(),b=links.getBoundingClientRect();px(a.left-b.left);pw(a.width);gsap.to(pill,{opacity:1,duration:.3})};
 $$('.links a').forEach(a=>{a.addEventListener('pointerenter',()=>travel(a));a.addEventListener('focus',()=>travel(a))});
 links.addEventListener('pointerleave',()=>gsap.to(pill,{opacity:0,duration:.35}));
}

/* text split — keeps markup intact by splitting only plain-heading elements */
function split(el,mode){const txt=el.textContent.trim();el.setAttribute('aria-label',txt);el.textContent='';const out=[],words=txt.split(/\s+/);words.forEach((w,i)=>{const ws=document.createElement('span');ws.className=mode==='word'?'w sw':'w';ws.setAttribute('aria-hidden','true');if(mode==='word'){ws.textContent=w;out.push(ws)}else{[...w].forEach(ch=>{const c=document.createElement('span');c.className='c';c.textContent=ch;ws.append(c);out.push(c)})}el.append(ws);if(i<words.length-1)el.append(' ')});return out}
const stmtWords=split($('#stmt'),'word');
const rhs=$$('.rh').map(h=>split(h,'word'));

/* smooth scroll + anchors */
let lenis=null;
if(!reduce){lenis=new Lenis({lerp:.09,wheelMultiplier:1,smoothWheel:true});lenis.on('scroll',ScrollTrigger.update);gsap.ticker.add(t=>lenis.raf(t*1000));gsap.ticker.lagSmoothing(0)}
$$('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const id=a.getAttribute('href');const t=$(id);if(!t)return;e.preventDefault();lenis?lenis.scrollTo(t,{offset:-24,duration:1.4}):t.scrollIntoView({behavior:'smooth'})}));

/* chrome state */
const nav=$('.nav'),onScroll=y=>nav.classList.toggle('is-scrolled',y>24);
onScroll(scrollY);addEventListener('scroll',()=>onScroll(scrollY),{passive:true});
if(lenis)lenis.on('scroll',({scroll})=>onScroll(scroll));

/* bottom tab bar: a droplet that springs to the active item */
const tabs=$$('[data-tab]'),drop=$('.tab-drop'),bar=$('.tabbar');
function moveDrop(el,instant){
 if(!drop||!bar||!el||getComputedStyle(bar).display==='none')return;
 const b=bar.getBoundingClientRect(),a=el.getBoundingClientRect();
 gsap.to(drop,{x:a.left-b.left,width:a.width,opacity:1,duration:instant?0:.55,ease:instant?'none':'back.out(1.3)',overwrite:true});
}
function setActive(id){
 tabs.forEach(a=>a.classList.toggle('is-active',a.dataset.tab===id));
 moveDrop(tabs.find(a=>a.dataset.tab===id));
}
tabs.forEach(a=>a.addEventListener('click',()=>setActive(a.dataset.tab)));
if('IntersectionObserver'in window){
 const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)setActive(e.target.id)}),{rootMargin:'-40% 0px -50% 0px'});
 ['work','services','projects','contact'].forEach(id=>{const s=document.getElementById(id);if(s)io.observe(s)});
}

/* button press ripple — feedback starts on pointer-down */
if(fine&&!reduce){document.addEventListener('pointerdown',e=>{const b=e.target.closest&&e.target.closest('.btn');if(!b)return;const r=b.getBoundingClientRect(),s=document.createElement('span');s.className='ripple';s.style.left=(e.clientX-r.left)+'px';s.style.top=(e.clientY-r.top)+'px';b.append(s);s.addEventListener('animationend',()=>s.remove())});}

/* material interactions: magnetic buttons, 3D-tilt case files */
if(fine){
 $$('[data-mag]').forEach(el=>{const qx=gsap.quickTo(el,'x',{duration:.6,ease:'power3'}),qy=gsap.quickTo(el,'y',{duration:.6,ease:'power3'});
  el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();qx((e.clientX-r.left-r.width/2)*.22);qy((e.clientY-r.top-r.height/2)*.3)});
  el.addEventListener('pointerleave',()=>{qx(0);qy(0)})});
 if(!reduce)$$('.wc').forEach(c=>{
  const rx=gsap.quickTo(c,'rotationX',{duration:.55,ease:'power3'}),ry=gsap.quickTo(c,'rotationY',{duration:.55,ease:'power3'});
  c.addEventListener('pointermove',e=>{const r=c.getBoundingClientRect();ry((e.clientX-r.left-r.width/2)/r.width*7);rx(-(e.clientY-r.top-r.height/2)/r.height*6)});
  c.addEventListener('pointerenter',()=>gsap.to(c,{y:-6,duration:.5,ease:'power3.out'}));
  c.addEventListener('pointerleave',()=>{rx(0);ry(0);gsap.to(c,{y:0,duration:.7,ease:'power3.out'})});
 });
}

if(reduce){$$('.stat b').forEach(b=>b.textContent=b.dataset.n);$('.stats').classList.add('is-in');$$('.sv').forEach(el=>el.classList.add('is-in'));$('.steps').classList.add('is-in')}
else{
  gsap.to('.prog',{scaleX:1,ease:'none',scrollTrigger:{start:0,end:'max',scrub:.2}});

  /* one orchestrated hero entrance */
  const tl=gsap.timeline({defaults:{ease:'expo.out'}});
  tl.from('.eyebrow',{opacity:0,y:16,duration:1},.1)
   .from('.line',{yPercent:112,opacity:0,filter:'blur(12px)',duration:1.5,stagger:.09},.18)
   .from('.hero .lede, .hero .cta-row, .hero .indexline',{opacity:0,y:22,duration:1.1,stagger:.09},.62)
   .from('.plate',{opacity:0,y:38,scale:.97,duration:1.5},.4)
   .from('.dock .dk',{opacity:0,y:26,duration:1.1,stagger:.09},.9)
   .from('.nav .bar',{yPercent:-150,opacity:0,duration:1.2},.2)
   .from('.tabbar',{yPercent:140,opacity:0,duration:1.2},.6);

  rhs.forEach(ws=>gsap.from(ws,{yPercent:45,opacity:0,duration:1.1,ease:'expo.out',stagger:.07,scrollTrigger:{trigger:ws[0].parentElement,start:'top 88%',once:true}}));
  $$('.sec-label,.sub,.contact-note').forEach(el=>gsap.from(el,{autoAlpha:0,y:18,duration:.9,ease:'expo.out',scrollTrigger:{trigger:el,start:'top 92%',once:true}}));

  gsap.to(stmtWords,{color:'#121712',ease:'none',stagger:.2,scrollTrigger:{trigger:'#stmt',start:'top 82%',end:'bottom 48%',scrub:true}});

  /* glass materializes — blur condenses into place on arrival */
  $$('.wc,.contact-panel').forEach(el=>gsap.from(el,{backdropFilter:'blur(0px) saturate(100%)',duration:.8,ease:'expo.out',scrollTrigger:{trigger:el,start:'top 90%',once:true}}));

  /* scroll-linked material: the glass breathes — scale + optical blur follow the scroll */
  gsap.timeline({scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}})
   .to('.plate',{y:-64,scale:.9,'--glass-blur':'40px',ease:'none'},0);
  gsap.fromTo('.contact-panel',{scale:.93,'--glass-blur':'14px'},{scale:1,'--glass-blur':'32px',ease:'none',scrollTrigger:{trigger:'.contact-panel',start:'top bottom',end:'center center',scrub:1}});
  gsap.to('.contact-panel',{scale:.97,'--glass-blur':'20px',ease:'none',scrollTrigger:{trigger:'.contact-panel',start:'center center',end:'bottom top',scrub:1}});
  $$('.wc').forEach(c=>gsap.fromTo(c,{scale:.965},{
   scale:1,ease:'none',scrollTrigger:{trigger:c,start:'top 95%',end:'top 45%',scrub:1}}));
  gsap.to('.wc .big',{x:-34,ease:'none',scrollTrigger:{trigger:'.stack',start:'top bottom',end:'bottom top',scrub:1}});
  gsap.to('.wm',{xPercent:-2,yPercent:26,ease:'none',scrollTrigger:{trigger:'footer',start:'top bottom',end:'bottom bottom',scrub:1}});
  gsap.from('.wm',{opacity:0,duration:1.2,ease:'expo.out',scrollTrigger:{trigger:'footer',start:'top 92%',once:true}});

  $$('.stat b').forEach(b=>{const o={v:0},n=+b.dataset.n;gsap.to(o,{v:n,duration:1.8,ease:'power3.out',scrollTrigger:{trigger:b,start:'top 92%',once:true},onUpdate:()=>b.textContent=Math.round(o.v)})});
  ScrollTrigger.create({trigger:'.stats',start:'top 88%',once:true,onEnter:()=>$('.stats').classList.add('is-in')});
  $$('.sv').forEach(el=>ScrollTrigger.create({trigger:el,start:'top 88%',once:true,onEnter:()=>el.classList.add('is-in')}));
  ScrollTrigger.create({trigger:'.steps',start:'top 88%',once:true,onEnter:()=>$('.steps').classList.add('is-in')});

  /* the discipline band borrows scroll velocity, then settles */
  const ticker=$('.ticker');
  if(ticker){
   ticker.classList.add('is-js');
   const loop=gsap.to('.ticker-t',{xPercent:-50,duration:58,ease:'none',repeat:-1});
   let idle;
   if(lenis)lenis.on('scroll',({velocity})=>{
    gsap.to(loop,{timeScale:1+Math.min(Math.abs(velocity)*.06,3),duration:.25,ease:'power2.out',overwrite:true});
    idle&&idle.kill();idle=gsap.delayedCall(.18,()=>gsap.to(loop,{timeScale:1,duration:1.1,ease:'power2.out'}));
   });
  }
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>ScrollTrigger.refresh());
}
</script></body></html>

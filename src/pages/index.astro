---
import '../styles/g.css';
const svg=(p,f)=>`<svg viewBox="0 0 24 24" width="20" height="20" fill="${f?'currentColor':'none'}" stroke="${f?'none':'currentColor'}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const I={
  mail:svg('<rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'),
  x:svg('<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',1),
  ig:svg('<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>'),
  gh:svg('<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>',1),
  up:svg('<path d="M7 17 17 7M8 7h9v9"/>'),
  down:svg('<path d="M12 4v16M6 14l6 6 6-6"/>'),
  copy:svg('<rect x="9" y="9" width="13" height="13" rx="2.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>'),
  work:svg('<rect x="3" y="7" width="18" height="14" rx="2.5"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 12h18"/>'),
  services:svg('<path d="M4 6h16M4 12h16M4 18h10"/>'),
  projects:svg('<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"/>'),
  contact:svg('<path d="M4 5h16v14H4zM4 7l8 6 8-6"/>')
};
const EMAIL='vancxe@aster.cx',X='https://x.com/vancxef',IG='https://instagram.com/thepersonarya';
const disc=['Penetration testing','Bug bounty','Vulnerability analysis','Reverse engineering','Detection engineering','Incident response'];
const work=[
  {m:'CVE-2025-20281',s:'CVSS 10.0',t:'Unauthenticated RCE in Cisco ISE',d:'Root-cause analysis of a critical pre-auth remote code execution: the broken invariant, the code path, why the patch holds, and detections defenders can deploy on day one.',h:'/posts/cve-2025-20281/index.html',big:'10.0',g:'#C6F440'},
  {m:'MITRE T1027',s:'Technique',t:'Walsh–Hadamard payload obfuscation',d:'How a Walsh–Hadamard transform hides shellcode from static analysis, with spectral analysis, key sensitivity and a working pipeline.',h:'/posts/wht-shellcode-obfuscation/index.html',big:'WHT',g:'#B6F13B'},
  {m:'HackerOne',s:'Bugcrowd',t:'Bug bounty hunting',d:'Web, mobile, AI and Web3 targets. Findings stay private until the vendor ships the fix.',h:null,big:'H1',g:'#97EA1E'}
];
const svc=[
  ['Penetration testing','Scoped, manual testing of web apps, APIs and mobile apps. You get reproducible findings with a fix path, not scanner output.'],
  ['Bug bounty','Independent hunting on HackerOne and Bugcrowd, reported with clear impact and working proof.'],
  ['Vulnerability analysis','Root-cause write-ups for disclosed CVEs: what broke, where in the code, and why the patch works.'],
  ['Reverse engineering','Disassembly and behavioural analysis of binaries, obfuscation and malware techniques.'],
  ['Detection engineering','Sigma, Suricata and SIEM queries shipped alongside every report.'],
  ['Incident response','Forensic notes that help responders validate scope and hunt the pattern.']
];
const proj=[['oh-my-pi','Coding agent with the IDE wired in','https://github.com/Arthsome/oh-my-pi'],['chime-health-check','Python health-check tooling','https://github.com/Arthsome/chime-health-check']];
const stats=[[2,'Public analyses'],[1,'CVE with detection rules'],[10,'Top CVSS score'],[6,'Disciplines']];
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Arthsome | Security researcher</title>
<meta name="description" content="Arthsome is an independent security researcher: penetration testing, bug bounty, vulnerability analysis and reverse engineering. Business inquiries: vancxe@aster.cx">
<meta name="theme-color" content="#F4F5EE"><meta property="og:title" content="Arthsome | Security researcher"><meta property="og:description" content="Finding what breaks before it does. Penetration testing, bug bounty and vulnerability research."><meta property="og:type" content="website"><meta name="twitter:card" content="summary">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23B6F13B'/%3E%3Ctext x='32' y='45' font-size='40' text-anchor='middle' fill='%231B3404' font-family='sans-serif' font-weight='700'%3EA%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Onest:wght@300..800&display=swap"></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<svg class="svg-defs" aria-hidden="true" focusable="false"><filter id="liquid-refract" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency="0.01 0.014" numOctaves="2" seed="7" result="noise"/><feGaussianBlur in="noise" stdDeviation="1.6" result="soft"/><feDisplacementMap in="SourceGraphic" in2="soft" scale="12" xChannelSelector="R" yChannelSelector="G"/></filter></svg>

<div class="prog" aria-hidden="true"></div>
<header class="nav"><div class="bar glass">
  <a class="logo" href="#top" aria-label="Arthsome, back to top"><i>A</i>Arthsome</a>
  <nav class="links" aria-label="Main"><a href="#work"><small>01</small>Work</a><a href="#services"><small>02</small>Services</a><a href="#projects"><small>03</small>Projects</a></nav>
  <a class="btn sm" data-mag href={`mailto:${EMAIL}`}>Hire me<Fragment set:html={I.up}/></a>
</div></header>

<nav class="tabbar glass" aria-label="Mobile">
  <a href="#work" data-tab="work"><Fragment set:html={I.work}/><span>Work</span></a>
  <a href="#services" data-tab="services"><Fragment set:html={I.services}/><span>Services</span></a>
  <a href="#projects" data-tab="projects"><Fragment set:html={I.projects}/><span>Projects</span></a>
  <a href="#contact" data-tab="contact"><Fragment set:html={I.contact}/><span>Contact</span></a>
</nav>

<main id="main">
<section class="hero" id="top">
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="eyebrow rv"><span class="pulse"></span>Independent security research · 2026</p>
      <h1 id="h1"><span class="line">Finding what</span><span class="line"><span class="mark">breaks</span> before</span><span class="line">it does.</span></h1>
      <p class="lede rv"><strong>I'm Vance, an independent security researcher working as Arthsome.</strong> Penetration testing, bug bounty and vulnerability research, with write-ups and detections published after the patch.</p>
      <div class="cta-row rv"><a class="btn" data-mag href={`mailto:${EMAIL}`}>Start a conversation<Fragment set:html={I.up}/></a><a class="btn ghost" data-mag href="#work">See the research<Fragment set:html={I.down}/></a></div>
      <div class="indexline rv"><span>00 / Introduction</span><span>Scroll to explore</span></div>
    </div>
    <aside class="plate glass" data-spot aria-label="Profile summary">
      <span class="plate-no">A—01</span>
      <figure class="plate-fig"><img src="/assets/img/portrait/crystal.png" alt="Arthsome crystal mark: a faceted form intersected by acid-lime traces"><figcaption>Fig. 01 — Structure under load</figcaption></figure>
      <div class="plate-meta">
        <div><span class="k">Focus</span><span class="v">Offensive security</span></div>
        <div><span class="k">Method</span><span class="v">Manual &amp; reproducible</span></div>
        <div><span class="k">Status</span><span class="v"><i></i>Open for inquiries</span></div>
      </div>
    </aside>
  </div>
  <div class="dock wrap"><div class="dock-inner glass">
    <div class="dk dk-main" data-spot><span class="ic" set:html={I.mail}></span><span class="dk-t"><span class="dk-l">Business inquiries</span><span class="dk-v">{EMAIL}</span></span><button class="copy" data-copy={EMAIL} aria-label="Copy email address" set:html={I.copy}></button></div>
    <a class="dk" data-spot href={X} target="_blank" rel="noopener"><span class="ic" set:html={I.x}></span><span class="dk-t"><span class="dk-l">X</span><span class="dk-v">@vancxef</span></span></a>
    <a class="dk" data-spot href={IG} target="_blank" rel="noopener"><span class="ic" set:html={I.ig}></span><span class="dk-t"><span class="dk-l">Instagram</span><span class="dk-v">@thepersonarya</span></span></a>
  </div></div>
</section>

<div class="ticker" aria-hidden="true"><div class="ticker-t">{[0,1].map(()=><div class="ticker-g">{disc.map(d=><><span>{d}</span><b></b></>)}</div>)}</div></div>

<section class="position"><div class="wrap position-inner">
  <p class="tag">01 / Position</p>
  <p class="statement" id="stmt">I take systems apart to find the flaw that breaks them, then write it up so the people who defend them can find it too.</p>
</div></section>

<section id="work"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">02 / Selected work</p><h2 class="rh">Research, published after the patch.</h2></div><p class="sub">Root-cause analysis, working proof and detections — released once the fix is live.</p></div>
  <div class="stack">{work.map((w,i)=>
   <article class="wc glass" style={`--g:${w.g}`} data-spot>
    <div class="wc-top"><span class="chip">{String(i+1).padStart(2,'0')} / {w.m}</span><span class={'chip'+(i===0?' hot':'')}>{w.s}</span></div>
    <h3>{w.t}</h3>
    <div class="wc-bot"><p>{w.d}</p>{w.h?<a class="btn" data-mag href={w.h}>Read the analysis<Fragment set:html={I.up}/></a>:<span class="chip">Private until fixed</span>}</div>
    <span class="big" aria-hidden="true">{w.big}</span>
   </article>)}</div>
</div></section>

<section id="services"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">03 / Services</p><h2 class="rh">Where I can help.</h2></div><p class="sub">Hands-on work, scoped clearly, reported so your team can reproduce and fix it.</p></div>
  <div class="ledger">{svc.map((s,i)=><div class="sv" data-spot><span class="sv-n">{String(i+1).padStart(2,'0')}</span><h3>{s[0]}</h3><p>{s[1]}</p><span class="sv-arrow" set:html={I.up}></span></div>)}</div>
</div></section>

<div class="wrap"><div class="stats">{stats.map(s=><div class="stat"><b data-n={s[0]}>0</b><span>{s[1]}</span></div>)}</div></div>

<section id="projects"><div class="wrap">
  <div class="sec-head"><div><p class="sec-label">04 / Projects</p><h2 class="rh">Side experiments.</h2></div></div>
  <div>{proj.map((p,i)=><a class="pj" href={p[2]} target="_blank" rel="noopener"><span class="pj-n">{String(i+1).padStart(2,'0')}</span><strong>{p[0]}</strong><span class="d">{p[1]}</span><span class="arr" set:html={I.up}></span></a>)}</div>
</div></section>

<section id="contact"><div class="wrap">
  <div class="contact-panel glass" data-spot>
    <div class="contact-grid">
      <div><p class="sec-label">05 / Contact</p><h2 class="rh">Have something worth testing?</h2><a class="mail" data-mag href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <div class="soc"><a class="btn" data-mag href={`mailto:${EMAIL}`}>Business inquiries<Fragment set:html={I.up}/></a><a class="btn ghost" data-mag href={X} target="_blank" rel="noopener"><Fragment set:html={I.x}/>@vancxef</a><a class="btn ghost" data-mag href={IG} target="_blank" rel="noopener"><Fragment set:html={I.ig}/>@thepersonarya</a><a class="btn ghost" data-mag href="https://github.com/Arthsome" target="_blank" rel="noopener"><Fragment set:html={I.gh}/>GitHub</a></div>
      </div>
      <p class="contact-note">Research published for defensive purposes. Findings stay private until the vendor ships the fix.</p>
    </div>
  </div>
</div></section>
</main>

<footer><div class="wrap"><div class="fl"><span>© 2026 Arthsome</span><span>Independent security research</span><a href="#top">Back to top ↑</a></div><div class="wm" aria-hidden="true">Arthsome</div></div></footer>

<script>
import {gsap} from 'gsap';import {ScrollTrigger} from 'gsap/ScrollTrigger';import Lenis from 'lenis';
gsap.registerPlugin(ScrollTrigger);
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,fine=matchMedia('(pointer:fine)').matches;

/* copy email */
$$('.copy').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.dataset.copy)}catch(_){const t=document.createElement('textarea');t.value=b.dataset.copy;document.body.append(t);t.select();document.execCommand('copy');t.remove()}b.setAttribute('data-ok','');setTimeout(()=>b.removeAttribute('data-ok'),1600)}));

/* glass spotlight */
document.addEventListener('pointermove',e=>{const t=e.target.closest&&e.target.closest('[data-spot]');if(t){const r=t.getBoundingClientRect();t.style.setProperty('--x',e.clientX-r.left+'px');t.style.setProperty('--y',e.clientY-r.top+'px')}},{passive:true});

/* text split — keeps markup intact by splitting only plain-heading elements */
function split(el,mode){const txt=el.textContent.trim();el.setAttribute('aria-label',txt);el.textContent='';const out=[],words=txt.split(/\s+/);words.forEach((w,i)=>{const ws=document.createElement('span');ws.className=mode==='word'?'w sw':'w';ws.setAttribute('aria-hidden','true');if(mode==='word'){ws.textContent=w;out.push(ws)}else{[...w].forEach(ch=>{const c=document.createElement('span');c.className='c';c.textContent=ch;ws.append(c);out.push(c)})}el.append(ws);if(i<words.length-1)el.append(' ')});return out}
const stmtWords=split($('#stmt'),'word');
const rhs=$$('.rh').map(h=>split(h,'word'));

/* smooth scroll + anchors */
let lenis=null;
if(!reduce){lenis=new Lenis({lerp:.09,wheelMultiplier:1,smoothWheel:true});lenis.on('scroll',ScrollTrigger.update);gsap.ticker.add(t=>lenis.raf(t*1000));gsap.ticker.lagSmoothing(0)}
$$('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const id=a.getAttribute('href');const t=id==='#top'||id==='#main'?$(id):$(id);if(!t)return;e.preventDefault();lenis?lenis.scrollTo(t,{offset:-24,duration:1.4}):t.scrollIntoView({behavior:'smooth'})}));

/* chrome state */
const nav=$('.nav'),onScroll=y=>nav.classList.toggle('is-scrolled',y>24);
onScroll(scrollY);addEventListener('scroll',()=>onScroll(scrollY),{passive:true});
if(lenis)lenis.on('scroll',({scroll})=>onScroll(scroll));

/* active bottom tab */
const tabs=$$('[data-tab]');
if('IntersectionObserver'in window){
 const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;tabs.forEach(a=>a.classList.toggle('is-active',a.dataset.tab===e.target.id))}),{rootMargin:'-40% 0px -50% 0px'});
 ['work','services','projects','contact'].forEach(id=>{const s=document.getElementById(id);if(s)io.observe(s)});
}

if(reduce){$$('.stat b').forEach(b=>b.textContent=b.dataset.n)}
else{
  gsap.to('.prog',{scaleX:1,ease:'none',scrollTrigger:{start:0,end:'max',scrub:.2}});

  /* one orchestrated hero entrance */
  const tl=gsap.timeline({defaults:{ease:'expo.out'}});
  tl.from('.eyebrow',{opacity:0,y:16,duration:1},.1)
   .from('.line',{yPercent:112,opacity:0,filter:'blur(12px)',duration:1.5,stagger:.09},.18)
   .from('.hero .lede, .hero .cta-row, .hero .indexline',{opacity:0,y:22,duration:1.1,stagger:.09},.62)
   .from('.plate',{opacity:0,y:38,scale:.97,duration:1.5},.4)
   .from('.dock .dk',{opacity:0,y:26,duration:1.1,stagger:.09},.9)
   .from('.nav .bar',{yPercent:-150,opacity:0,duration:1.2},.2)
   .from('.tabbar',{yPercent:140,opacity:0,duration:1.2},.6);

  rhs.forEach(ws=>gsap.from(ws,{yPercent:45,opacity:0,duration:1.1,ease:'expo.out',stagger:.07,scrollTrigger:{trigger:ws[0].parentElement,start:'top 88%',once:true}}));

  gsap.to(stmtWords,{color:'#121712',ease:'none',stagger:.2,scrollTrigger:{trigger:'#stmt',start:'top 82%',end:'bottom 48%',scrub:true}});

  $$('.stat b').forEach(b=>{const o={v:0},n=+b.dataset.n;gsap.to(o,{v:n,duration:1.8,ease:'power3.out',scrollTrigger:{trigger:b,start:'top 92%',once:true},onUpdate:()=>b.textContent=Math.round(o.v)})});

  gsap.from('.wm',{yPercent:26,opacity:0,duration:1.6,ease:'expo.out',scrollTrigger:{trigger:'footer',start:'top 92%',once:true}});

  if(fine){
    $$('[data-mag]').forEach(el=>{const qx=gsap.quickTo(el,'x',{duration:.6,ease:'power3'}),qy=gsap.quickTo(el,'y',{duration:.6,ease:'power3'});
     el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();qx((e.clientX-r.left-r.width/2)*.22);qy((e.clientY-r.top-r.height/2)*.3)});
     el.addEventListener('pointerleave',()=>{qx(0);qy(0)})});
  }
}
</script></body></html>
